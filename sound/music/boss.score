# boss: the Hollow Warden's fight (issue #274), from the moment its room
# shuts until it falls, in place of the dungeon's song. A minor, the
# dungeon song's key, 104 bpm, two parts of 8 bars.
# one, its phase 1: a low choir on the chord, the bass tolling the root on
# each bar's first beat and a kick on 1 and 3, a stone set down; a piano's
# bell on the bar's first beat, and a brass call A3 E4 answered every
# other bar. Am Am F E, Am Am Dm E.
# two, from its phase 2 on: the bass runs in eighths on the root, kick and
# snare drive with a hat on the eighths, strings hold the chord and the
# brass climbs to A4 and C5. Am F Dm E, Am F G E.
# Each part moves to the other on the next bar.
tempo 104
meter 4

instrument choir = warm:choir
instrument bass  = warm:bass
instrument kick  = warm:kick
instrument snare = warm:snare
instrument hat   = warm:hat
instrument brass = warm:brass
instrument piano = warm:piano
instrument pad   = warm:strings

track choir choir vel=0.5
track toll  bass  vel=0.65
track stone kick  vel=0.7 transpose=0
track bell  piano vel=0.45
track call  brass vel=0.6
track pad   pad   vel=0.42
track run   bass  vel=0.55
track drive kick  vel=0.65 transpose=0
track snare snare vel=0.5 transpose=0
track hat   hat   vel=0.28 transpose=0
track horn  brass vel=0.62

let ch[Am] = A2+E3:4
let ch[F]  = F2+C3:4
let ch[Dm] = D3+A3:4
let ch[G]  = G2+D3:4
let ch[E]  = E2+B2:4
let toll[Am] = A1:1! r:3
let toll[F]  = F1:1! r:3
let toll[Dm] = D2:1! r:3
let toll[E]  = E1:1! r:3
let oneChords = Am Am F E Am Am Dm E
let stone = C2:1! r C2:1 r
let pad[Am] = A3+E4:4
let pad[F]  = F3+C4:4
let pad[Dm] = D3+A3:4
let pad[G]  = G3+D4:4
let pad[E]  = E3+B3:4
let run[Am] = A1:.5! A2:.5 A1:.5 A2:.5 A1:.5! A2:.5 A1:.5 A2:.5
let run[F]  = F1:.5! F2:.5 F1:.5 F2:.5 F1:.5! F2:.5 F1:.5 F2:.5
let run[Dm] = D2:.5! D3:.5 D2:.5 D3:.5 D2:.5! D3:.5 D2:.5 D3:.5
let run[G]  = G1:.5! G2:.5 G1:.5 G2:.5 G1:.5! G2:.5 G1:.5 G2:.5
let run[E]  = E1:.5! E2:.5 E1:.5 E2:.5 E1:.5! E2:.5 E1:.5 E2:.5
let twoChords = Am F Dm E Am F G E
let drive = C2:1! C2:.5 C2:.5 C2:1! r
let back = r C4! r C4!
let hats = C4:.5 C4:.5~ C4:.5 C4:.5~ C4:.5 C4:.5~ C4:.5 C4:.5~

pattern One
  choir: $ch[$oneChords]
  toll: $toll[$oneChords]
  stone: $stone*8
  bell: A3:4 | r:4 | C4:4 | B3:4 | A3:4 | r:4 | D4:4 | G#3:4
  call: r:4 | A3:1 E4:1.5 D4:.5 C4:1 | r:4 | B3:2 G#3:2 |
        r:4 | A3:1 E4:1.5 F4:.5 E4:1 | r:4 | D4:2 B3:2

pattern Two
  pad: $pad[$twoChords]
  run: $run[$twoChords]
  drive: $drive*8
  snare: $back*8
  hat: $hats*8
  horn: E4:1.5 F4:.5 E4:1 C4:1 | A4:2 F4:2 | F4:1.5 E4:.5 D4:1 F4:1 | E4:4 |
        E4:1.5 F4:.5 E4:1 C4:1 | A4:2 C5:2 | B4:1.5 A4:.5 G4:1 B4:1 | G#4:4

segment one: One
segment two: Two
start one
transition one -> two sync=bar
transition two -> one sync=bar
